# Copie para backend/.env e ajuste. O .env NÃO deve ser versionado.
AMBIENTE=desenvolvimento

# Chave de assinatura dos tokens JWT (mínimo 32 caracteres).
# Gerar: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CHAVE_SECRETA_JWT=
ALGORITMO_JWT=HS256
MINUTOS_EXPIRACAO_TOKEN=60
# Renovação do token enquanto há uso: renova quando faltam menos de N minutos; HORAS_SESSAO_MAXIMA=0 não limita a sessão
# MINUTOS_RENOVACAO_TOKEN=30
# HORAS_SESSAO_MAXIMA=0

# Banco de dados PostgreSQL
URL_BANCO_DADOS=postgresql+psycopg://usuario:senha@localhost:5432/banco

# LDAP: chave Fernet que cifra a senha de bind dos diretórios. Trocar a chave exige informar as senhas de novo.
# Gerar: backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CIFRA_LDAP=
# Intervalo da sincronização automática do diretório ativo (0 desativa)
INTERVALO_SINCRONIZACAO_LDAP_MINUTOS=15
TEMPO_LIMITE_LDAP_SEGUNDOS=5

# Conta administrativa principal (SuperRoot local). Apenas o HASH bcrypt da senha é armazenado.
# A senha é reaplicada à conta no banco a cada inicialização da API.
# Gerar: backend/.venv/bin/python scripts/gerar-hash-senha.py
# Use aspas simples: o hash contém "$".
LOGIN_ADMIN=root
HASH_SENHA_ADMIN=''
NOME_ADMIN=Administrador

# Somente se o frontend for servido por outra origem (JSON). Ex.: ["http://localhost:4200"]
ORIGENS_CORS=[]

# Anexos PDF do módulo de contratos (fora do banco). O usuário do serviço precisa gravar aqui.
# ANEXOS_DIRETORIO=/home/administrador/projeto/dados/anexos
# ANEXOS_TAMANHO_MAXIMO_MB=25

# Links dos e-mails, tomador das notas fiscais e setor do Financeiro (etapa de retenção de tributos)
# URL_PUBLICA=https://portal.spi.sp.gov.br
# TOMADOR_CNPJ=96480850000103
# SETOR_FINANCEIRO=Diretoria de Orçamento e Finanças
# Setor da CGP (Coordenadoria de Gestão de Pessoas): acesso total ao Módulo RH (inclui os setores filhos)
# SETOR_CGP=Coordenadoria de Gestão de Pessoas

# Contratações: versões por documento (100), minutos de pausa que abrem uma sessão de edição (30) e dias de revisão parada até o aviso (5)
# CONTRATACOES_LIMITE_VERSOES=100
# CONTRATACOES_SESSAO_MINUTOS=30
# CONTRATACOES_DIAS_AVISO=5

# Protocolo: dias de reserva sem documento até o aviso ao responsável (padrão 5)
# PROTOCOLO_DIAS_AVISO=5

# Assinatura de e-mail (opcional; os padrões são os da SPI)
# ASSINATURA_SECRETARIA=Secretaria de Parcerias em Investimentos – SPI
# ASSINATURA_ENDERECO=Rua Iaiá, 126 - Itaim Bibi
# ASSINATURA_CIDADE=São Paulo/SP – CEP 04542-906
# ASSINATURA_TELEFONE_PREFIXO=(11) 3702-

# Importação do SGI SPI (botão "Importar do SGI" do SuperRoot). As senhas são pedidas na tela.
# MIGRACAO_SGI_HOST=10.23.1.220
# MIGRACAO_SGI_USUARIO=administrador
# MIGRACAO_LOCAL_HOST=127.0.0.1
# MIGRACAO_LOCAL_USUARIO=administrador
# MIGRACAO_DIRETORIO=/home/administrador/projeto/dados/migracao-sgi
