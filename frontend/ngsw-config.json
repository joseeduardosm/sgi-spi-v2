{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "aplicacao",
      "installMode": "prefetch",
      "resources": { "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] }
    },
    {
      "name": "recursos",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/assets/**", "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"] }
    }
  ],
  "dataGroups": [
    {
      "name": "patrimonio-consulta",
      "urls": ["/api/patrimonio/localizacoes", "/api/patrimonio/grupos", "/api/patrimonio/acesso"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 10, "maxAge": "7d", "timeout": "4s" }
    }
  ]
}
