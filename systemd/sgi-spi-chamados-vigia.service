[Unit]
Description=sgi-spi: vigia dos Chamados: confere se as tarefas automáticas e o e-mail estão andando
After=network.target postgresql.service

[Service]
Type=oneshot
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__PROJETO__/backend
ExecStart=__PROJETO__/backend/.venv/bin/python -m app.tarefas.chamados vigia
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
