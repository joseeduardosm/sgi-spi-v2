[Unit]
Description=sgi-spi: fila de e-mails dos avisos automáticos da mensageria
After=network.target postgresql.service

[Service]
Type=oneshot
User=__USUARIO__
Group=__USUARIO__
WorkingDirectory=__PROJETO__/backend
ExecStart=__PROJETO__/backend/.venv/bin/python -m app.tarefas.mensageria emails
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
